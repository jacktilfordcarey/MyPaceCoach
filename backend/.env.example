# Copy this file to backend/.env and replace the placeholder values.
# This project expects the app to run from the backend folder, so the .env file lives there.

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8081
SESSION_SECRET=replace-with-a-long-random-string

# PostgreSQL local database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mypace
DB_USER=postgres
DB_PASSWORD=root
# Optional: if you prefer to use a single DATABASE_URL variable instead of DB_* values,
# you can set it here and leave the DB_* values unset.
# DATABASE_URL=postgres://postgres:root@localhost:5432/mypace

# Strava OAuth
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_CALLBACK_URL=http://localhost:3000/api/auth/strava/callback

# AI config
# The app defaults to Anthropic as the primary provider and OpenRouter as the fallback.
LLM_PROVIDER=anthropic
LLM_FALLBACK_ENABLED=true
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=3
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-oss-120b:free
